{
  "lexicon": 1,
  "id": "jp.i32.chain.actor.profile",
  "defs": {
    "main": {
      "type": "record",
      "description": "CHAIN-specific profile fields. Display name, description and avatar live in app.bsky.actor.profile.",
      "key": "literal:self",
