        "type": "object",
        "required": ["createdAt"],
        "properties": {
          "status": {
            "type": "string",
            "maxLength": 400,
            "maxGraphemes": 40,
            "description": "Short status message."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
