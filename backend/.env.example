# 項目の意味は specification/backend/02-conventions.md §6。`make env` で鍵を埋めた .env を作れる。
CHAIN_ENV=dev
CHAIN_LISTEN=:8080
CHAIN_PUBLIC_URL=https://chain.i32.jp
CHAIN_APP_REDIRECT=chain://auth/callback
CHAIN_DB_PATH=data/app.db
CHAIN_REDIS_URL=redis://localhost:6379/0
CHAIN_MEDIA_DIR=data/media
CHAIN_SECRET_KEY=
CHAIN_JWT_KEY=
# 空なら dev では loopback クライアント（http://127.0.0.1:8080 でログイン）。Tunnel 経由で試すなら `go run ./cmd/keygen` の出力を入れる
CHAIN_OAUTH_PRIVATE_KEY=
CHAIN_NANOGPT_KEY=
CHAIN_FCM_CREDENTIALS=
